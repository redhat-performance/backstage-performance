#!/bin/bash
# Effective test.env for periodic job: mvp-cpt-xs
# Source: ci-operator/config/redhat-performance/backstage-performance/redhat-performance-backstage-performance-main.yaml
# Workflow: redhat-performance-backstage-performance-xl

## Scenario / load test
export SCENARIO=mvp
export USERS=50
export WORKERS=10
export DURATION=10m
export SPAWN_RATE=10
export PRE_LOAD_DB=true
export USE_PR_BRANCH=false
export WAIT_FOR_SEARCH_INDEX=false

## Catalog / users population
export API_COUNT=12500
export COMPONENT_COUNT=12500
export BACKSTAGE_USER_COUNT=10000
export GROUP_COUNT=150000
export CATALOG_REFRESH_INTERVAL_MINUTES=10080

## RHDH deployment
export RHDH_INSTALL_METHOD=helm
export RHDH_DEPLOYMENT_REPLICAS=3
export RHDH_DB_REPLICAS=1
export RHDH_DB_STORAGE=20Gi
export RHDH_KEYCLOAK_REPLICAS=1
export ENABLE_ORCHESTRATOR=true
export ENABLE_RBAC=false
export ENABLE_PROFILING=false
export PAGE_N_COUNT=0
export CATALOG_TAB_N_COUNT=0
export ENSURE_CATALOG_POPULATION_TIMEOUT=3600
