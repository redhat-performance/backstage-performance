# export RBAC_POLICY_PVC_STORAGE=100Mi  # Size of the PVC for RBAC policy
export ENABLE_PROFILING=false
export RHDH_LOG_LEVEL=debug
export KEYCLOAK_LOG_LEVEL=debug
export PSQL_LOG=false
export PSQL_EXPORT=false
export RHDH_METRICS=true
export ENSURE_CATALOG_POPULATION_TIMEOUT=7200
export CATALOG_REFRESH_INTERVAL_MINUTES=120
export LDAP_SCHEDULE_TIMEOUT_MINUTES=120
export RHDH_STARTUP_TIMEOUT_SECONDS=7200

## Scalability testing
export SCALE_WORKERS="1"
export SCALE_ACTIVE_USERS_SPAWN_RATES="1:1"
export SCALE_BS_USERS_GROUPS="1000:10000"
export SCALE_RBAC_POLICY_SIZE="10000"
export SCALE_CATALOG_SIZES="1250:1250"
export SCALE_REPLICAS="1:1"
export SCALE_DB_STORAGES="20Gi"
export SCALE_CPU_REQUESTS_LIMITS="2:2"
export SCALE_MEMORY_REQUESTS_LIMITS="3Gi:3Gi"
export SCALE_PAGE_N_CATALOG_TAB_N_COUNTS="0:0 5:5 25:25 50:50 100:100"
